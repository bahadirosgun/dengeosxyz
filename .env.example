# Lovable Cloud / Supabase (publishable — safe to ship to client)
# Example:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (NOT exposed to the browser; configure as Vercel/Cloudflare env vars)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lovable AI Gateway (server-only) — used by meal/program AI server functions
LOVABLE_API_KEY=

# Optional public URL for production callbacks/docs
VITE_APP_URL=
